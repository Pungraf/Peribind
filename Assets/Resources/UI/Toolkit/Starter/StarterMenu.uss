.starter-screen {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.starter-card {
    width: 100%;
    max-width: 700px;
    min-height: 500px;
    background-image: url("../wooden/panel_large_set.png");
    -unity-slice-left: 72px;
    -unity-slice-right: 72px;
    -unity-slice-top: 72px;
    -unity-slice-bottom: 72px;
    padding-left: 72px;
    padding-right: 72px;
    padding-top: 72px;
    padding-bottom: 72px;
}

.auth-panel {
    flex-direction: column;
    margin-top: 12px;
}

.section-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--pb-text-0);
    -unity-text-align: middle-center;
    unity-text-align: middle-center;
    text-align: center;
    width: 100%;
    align-self: center;
    margin-top: 6px;
    margin-bottom: 4px;
}

.starter-card .title-text {
    color: var(--pb-text-0);
    -unity-text-align: middle-center;
    unity-text-align: middle-center;
    text-align: center;
    width: 100%;
    align-self: center;
}

#title-label {
    -unity-text-align: middle-center;
    unity-text-align: middle-center;
    text-align: center;
    width: 100%;
    align-self: center;
}

.info-label {
    width: 82.5%;
    align-self: center;
    min-height: 36px;
    margin-top: 10px;
    margin-bottom: 10px;
    color: var(--pb-text-on-dark);
    unity-text-align: middle-left;
    white-space: normal;
    background-image: url("../wooden/panel_small_stone.png");
    -unity-slice-left: 34px;
    -unity-slice-right: 34px;
    -unity-slice-top: 34px;
    -unity-slice-bottom: 34px;
    padding-left: 32px;
    padding-right: 4px;
    padding-top: 8px;
    padding-bottom: 8px;
}
