.lobby-screen {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.lobby-screen .screen-background-overlay {
    background-image: url("../png/overlay_vignette_1920x1080.png");
}

.lobby-card {
    width: 100%;
    max-width: 1040px;
    background-image: url("../wooden/panel_large_set.png");
    -unity-slice-left: 80px;
    -unity-slice-right: 80px;
    -unity-slice-top: 80px;
    -unity-slice-bottom: 80px;
    padding-left: 88px;
    padding-right: 88px;
    padding-top: 70px;
    padding-bottom: 60px;
}

.lobby-title-row {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 2px;
}

.lobby-page-title {
    flex-grow: 1;
    unity-text-align: middle-left;
    margin-bottom: 0;
}

.lobby-top-return-button {
    width: 170px;
    min-height: 56px;
    max-height: 56px;
    margin-top: 2px;
    margin-bottom: 0;
}

.lobby-grid {
    flex-direction: row;
    margin-top: 8px;
    align-items: stretch;
}

.lobby-left {
    flex-grow: 0;
    width: 420px;
    margin-right: 24px;
}

.lobby-section {
    flex-shrink: 0;
    margin-bottom: 16px;
}

.lobby-left .lobby-section {
    margin-bottom: 8px;
}

.lobby-section-body {
    margin-top: 2px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 52px;
    padding-bottom: 34px;
    align-items: stretch;
    background-image: url("../wooden/panel_small_set.png");
    -unity-slice-left: 34px;
    -unity-slice-right: 34px;
    -unity-slice-top: 34px;
    -unity-slice-bottom: 34px;
}

.lobby-section-body-create {
    min-height: 348px;
    padding-top: 60px;
}

.lobby-section-body-join {
    min-height: 252px;
    padding-bottom: 48px;
}

.lobby-section-body-match {
    min-height: 372px;
    padding-top: 52px;
    padding-bottom: 52px;
}

.lobby-right {
    flex-grow: 1;
    min-width: 420px;
    flex-direction: column;
}

.lobby-right-top {
    flex-grow: 1;
    min-height: 0;
}

.lobby-right-header-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 34px;
    margin-bottom: 2px;
}

.lobby-right-title {
    margin-right: 12px;
}

.lobby-refresh-button {
    width: 170px;
    min-height: 56px;
    max-height: 56px;
    margin-top: 0;
    margin-bottom: 0;
}

.lobby-section-right-lower {
    margin-top: auto;
    margin-bottom: 8px;
}

.section-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--pb-text-0);
    margin-top: 10px;
    margin-left: 8px;
    margin-bottom: 0;
}

.auth-field {
    width: 90%;
    align-self: center;
    margin-top: 2px;
    margin-bottom: 8px;
}

.lobby-section-body > .auth-field:first-child {
    margin-top: 12px;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.button-row > Button {
    flex-grow: 0;
    width: 170px;
    min-height: 56px;
    max-height: 56px;
    margin-right: 8px;
    margin-top: 0;
    margin-bottom: 0;
}

.button-row > Button:last-child {
    margin-right: 0;
}

.button-stack {
    flex-direction: column;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.button-stack > Button {
    width: 220px;
    min-height: 73px;
    max-height: 73px;
    margin-top: 0;
    margin-bottom: 8px;
}

.button-stack > Button:last-child {
    margin-bottom: 0;
}

.lobby-section-body > Button {
    width: 232px;
    min-height: 77px;
    max-height: 77px;
    align-self: center;
}

.status-label {
    margin-top: 6px;
    margin-bottom: 10px;
}

.status-shell {
    min-height: 46px;
    margin-top: 6px;
    margin-bottom: 10px;
    flex-direction: row;
    align-items: center;
    padding-left: 30px;
    padding-right: 14px;
    background-image: url("../wooden/panel_small_stone.png");
    -unity-slice-left: 34px;
    -unity-slice-right: 34px;
    -unity-slice-top: 34px;
    -unity-slice-bottom: 34px;
}

.lobby-status-text {
    flex-grow: 1;
    min-height: 0;
    margin-top: 0;
    margin-bottom: 0;
    color: var(--pb-text-on-dark);
    font-size: 14px;
    unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.lobby-list-scroll {
    flex-grow: 1;
    min-height: 260px;
    max-height: 380px;
    padding-right: 4px;
}

.lobby-row-button {
    min-height: 84px;
    max-height: 84px;
    margin-top: 5px;
    margin-bottom: 5px;
    background-image: url("../wooden/btn_big_idle.png");
    -unity-slice-left: 15px;
    -unity-slice-right: 15px;
    -unity-slice-top: 15px;
    -unity-slice-bottom: 30px;
    -unity-background-image-tint-color: white;
    color: var(--pb-text-on-dark);
    padding-left: 22px;
    padding-right: 12px;
    padding-top: 1px;
    padding-bottom: 23px;
    unity-text-align: middle-left;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lobby-row-button:hover {
    background-image: url("../wooden/btn_big_hover_tint.png");
    -unity-slice-left: 15px;
    -unity-slice-right: 15px;
    -unity-slice-top: 13px;
    -unity-slice-bottom: 35px;
    color: rgb(248, 236, 204);
}

.lobby-row-button:active {
    background-image: url("../wooden/btn_big_pressed.png");
    -unity-slice-left: 15px;
    -unity-slice-right: 15px;
    -unity-slice-top: 35px;
    -unity-slice-bottom: 10px;
}

.lobby-row-button:active:hover {
    background-image: url("../wooden/btn_big_pressed.png");
    -unity-slice-left: 15px;
    -unity-slice-right: 15px;
    -unity-slice-top: 35px;
    -unity-slice-bottom: 10px;
}

.lobby-row-button > .unity-button__text,
.lobby-row-button > .unity-text-element,
.lobby-row-button .unity-button__text,
.lobby-row-button .unity-text-element {
    color: var(--pb-text-on-dark);
    translate: 0px 0px;
}

.lobby-row-button:active > .unity-button__text,
.lobby-row-button:active > .unity-text-element,
.lobby-row-button:active .unity-button__text,
.lobby-row-button:active .unity-text-element {
    translate: 0px 0px;
}

.lobby-row-button:hover > .unity-button__text,
.lobby-row-button:hover > .unity-text-element,
.lobby-row-button:hover .unity-button__text,
.lobby-row-button:hover .unity-text-element {
    color: rgb(248, 236, 204);
}

.lobby-screen TextField {
    flex-direction: row;
    align-items: center;
}

.lobby-screen TextField > .unity-base-field__label {
    width: 96px;
    min-width: 96px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-right: 10px;
    text-align: right;
    -unity-text-align: middle-right;
    unity-text-align: middle-right;
    font-size: 16px;
}

.lobby-name-field > .unity-base-field__label {
    width: 78px;
    min-width: 78px;
    white-space: normal;
    text-overflow: clip;
    overflow: visible;
    line-height: 14px;
}

.lobby-screen TextField > .unity-base-field__input {
    flex-grow: 1;
    min-height: 64px;
    padding-left: 25px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 18px;
}
